sensor_mcu = mcu
min_temp = 0
max_temp = 85

[temperature_sensor accel_temp]
sensor_type = temperature_mcu
sensor_mcu = btt_lis2dw
min_temp = 0
max_temp = 85

[temperature_sensor rhino_linux]
sensor_type = temperature_host
min_temp = 10
max_temp = 105

[fan]
pin = PB7
hardware_pwm = False
cycle_time = 0.010
kick_start_time = 0.2

[heater_fan HeatBreak]
pin = PB6
hardware_pwm = False
fan_speed = 1.0
cycle_time = 0.010
kick_start_time = 0.1
heater = extruder
heater_temp = 50
max_power = 1.0
shutdown_speed = 1.0

[controller_fan driver_Fan]
