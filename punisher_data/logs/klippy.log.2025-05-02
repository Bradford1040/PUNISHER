	'shaper_freq_x': 33.000,
	'damping_ratio_x': 0.000,
	'shaper_y': 'smooth_2hump_ei',
	'shaper_freq_y': 29.700,
	'damping_ratio_y': 0.000,
	}
gcode = 

[gcode_macro Performance]
