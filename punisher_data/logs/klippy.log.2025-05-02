restart_method = command

[printer]
kinematics = limited_corexy
max_velocity = 370
max_z_velocity = 22
max_accel = 48000
max_x_accel = 40000
max_y_accel = 20000
max_z_accel = 800
square_corner_velocity = 18
minimum_cruise_ratio = 0.42
scale_xy_accel = True

[danger_options]
