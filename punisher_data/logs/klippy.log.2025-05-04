	G4 P2000
	ACCELEROMETER_QUERY
	G4 P1000
	M117 ACCEL_LOADED!

[gcode_macro CHECK_ACCEL]
gcode = 
	ACCELEROMETER_QUERY

[gcode_macro Calibrate_Home]
gcode = 
	M190 S75
	M109 S225
	_B28
	G4 P1000
	PROBE_CALIBRATE

[gcode_macro TIP_CLEAN]
gcode = 
	SAVE_GCODE_STATE NAME=tip_clean_state
	{% set wipe_count = 10|int %}
	G90
	G1 F1500
	G1 X40 Y384
	{% for wipe in range(wipe_count) %}
	G1 X{50 + (40 * (loop.index is even))}
	{% endfor %}
	RESTORE_GCODE_STATE NAME=tip_clean_state MOVE_SPEED=100 MOVE=0

[gcode_macro calibrate_extruder]
gcode = 
	{% set length = params.LENGTH|default(100)|float %}
	{% set target = params.TARGET|float %}
	{% set min_temp = printer.configfile.settings.extruder.min_extrude_temp|int %}
	{% if not printer.extruder.can_extrude %}
	RESPOND TYPE=error MSG="Below minimum temp. Heating extruder..."
	M109 S{min_temp|int}
	{% endif %}
	{% if params.TARGET is defined %}
	{% if min_temp|int < target|float %}
	M109 S{target}
	M117 Heating nozzle...
	{% endif %}
	{% endif %}
	M117 EXTRUDING...
	G92 E0
