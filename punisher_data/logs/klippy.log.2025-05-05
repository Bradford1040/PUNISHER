===== Config file =====
[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32h723xx_2C0011000851313332323730-if00
is_non_critical = False
baud = 250000
restart_method = command

[printer]
kinematics = limited_corexy
max_velocity = 370
max_z_velocity = 22
max_accel = 48000
max_x_accel = 40000
max_y_accel = 20000
max_z_accel = 800
square_corner_velocity = 18
