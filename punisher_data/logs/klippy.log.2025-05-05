[gcode_macro _SET_MPC_MATERIAL]
description = Set heater MPC parameters for a given material
variable_filament_table = 
	
	{
	
	"PLA"       : ( 1.25, 1.93 ),
	"PETG"      : ( 1.27, 1.87 ),
	"PC+ABS"    : ( 1.15, 2.20 ),
	"ABS"       : ( 1.06, 2.40 ),
	"ASA"       : ( 1.10, 2.10 ),
	"PA6"       : ( 1.12, 2.50 ),
	"PA"        : ( 1.15, 2.50 ),
	"PC"        : ( 1.20, 1.90 ),
	"TPU"       : ( 1.21, 1.70 ),
	"TPU-90A"   : ( 1.15, 2.00 ),
	"TPU-95A"   : ( 1.22, 2.00 ),
